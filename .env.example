# Copy this file to .env and paste your key. Never commit the real key.
ROBOT_LLM_API_KEY=your-api-key-here

# Optional overrides; these defaults already match the application.
ROBOT_LLM_MODEL=gpt-4.1-mini
ROBOT_LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
ROBOT_TRANSCRIPTION_MODEL=whisper-1
ROBOT_TRANSCRIPTION_ENDPOINT=https://api.openai.com/v1/audio/transcriptions

# Optional local generated replies through Ollama (also available via --local-ai).
# ROBOT_LOCAL_AI=true
# ROBOT_LOCAL_MODEL=llama3.2:3b
# ROBOT_LOCAL_ENDPOINT=http://127.0.0.1:11434/v1/chat/completions
