[Unit]
Description=FRED dementia care companion
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fred
Group=fred
SupplementaryGroups=dialout video audio
WorkingDirectory=/opt/fred
Environment=PYTHONUNBUFFERED=1
Environment=ROBOT_PICO_DEVICE=auto
Environment=ROBOT_CAREGIVER_AUTH_ENABLED=1
EnvironmentFile=-/opt/fred/.env
ExecStart=/opt/fred/.venv/bin/dementia-care-robot web --host 127.0.0.1 --port 8080 --data-dir /var/lib/fred --pico ${ROBOT_PICO_DEVICE}
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/fred
UMask=0077

[Install]
WantedBy=multi-user.target
